"""Terminator by Chris Jones <cmsj@tenshu.net>"""

import sys
import os

try:
    ORIGCWD = os.getcwd()
except OSError:
    ORIGCWD = os.path.expanduser("~")

# Check we have simple basics like Gtk+ and a valid $DISPLAY
try:
    import gi
    gi.require_version('Gtk','3.0')
    # pylint: disable-msg=W0611
    from gi.repository import Gtk, Gdk, GLib

    if Gdk.Display.get_default() == None:
        print('You need to run terminator in an X environment. ' \
              'Make sure $DISPLAY is properly set')
        sys.exit(1)

except ImportError:
    print('You need to install the python bindings for ' \
           'gobject, gtk and pango to run Terminator.')
    sys.exit(1)

import terminatorlib.optionparse
from terminatorlib.terminator import Terminator
from terminatorlib.factory import Factory
from terminatorlib.version import APP_NAME, APP_VERSION
from terminatorlib.util import dbg, err
from terminatorlib.layoutlauncher import LayoutLauncher
from terminatorlib.configjson import ConfigJson

if __name__ == '__main__':

    dbus_service = None

    dbg ("%s starting up, version %s" % (APP_NAME, APP_VERSION))
  
    GLib.set_prgname(APP_NAME)

    OPTIONS,dbus_options = terminatorlib.optionparse.parse_options()
    if OPTIONS.configjson:
        configjson = ConfigJson()
        layoutname = configjson.extend_config(OPTIONS.configjson)
        if layoutname and ((not OPTIONS.layout) or OPTIONS.layout == 'default'):
            OPTIONS.layout = layoutname
            if not OPTIONS.profile:
               OPTIONS.profile = configjson.get_profile_to_use()
    
    TERMINATOR = Terminator()
    TERMINATOR.set_origcwd(ORIGCWD)

    if OPTIONS.select:
        # launch gui, return selection
        LAYOUTLAUNCHER=LayoutLauncher()
    else:
        # Attempt to import our dbus server. If one exists already we will just
        # connect to that and ask for a new window. If not, we will create one and
        # continue. Failure to import dbus, or the global config option "dbus"
        # being False will cause us to continue without the dbus server and open a
        # window.
        try:
            if OPTIONS.nodbus:
                dbg('dbus disabled by command line')
                raise ImportError
            from terminatorlib import ipc
            import dbus
            try:
                dbus_service = ipc.DBusService()

                if(OPTIONS.reload):
                    # Reload only is executed when exist at least one window,
                    # if not there is nothing to reload
                    sys.exit()

            except ipc.DBusException:
                dbg('Unable to become master process, operating via DBus')
                # get rid of the None and True types so dbus can handle them (empty
                # and 'True' strings are used instead), also arrays are joined 
                # (the -x argument for example)
                if OPTIONS.working_directory is None:
                    OPTIONS.working_directory = ORIGCWD
                    dbus_options['working_directory'] = ORIGCWD
                optionslist = dbus.Dictionary(dbus_options, signature='ss')
                if OPTIONS.new_tab:
                    dbg('Requesting a new tab')
                    ipc.new_tab_cmdline(optionslist)
                elif OPTIONS.toggle_visibility:
                    dbg('requesting to toggle windows visibility')
                    ipc.toggle_visibility_cmdline(optionslist)
                elif OPTIONS.reload:
                    dbg('requesting to reload configuration for all windows')
                    ipc.reload_configuration()
                elif OPTIONS.unhide:
                    print('requesting to unhide windows')
                    ipc.unhide_cmdline(optionslist)
                else:
                    dbg('Requesting a new window')
                    ipc.new_window_cmdline(optionslist)
                sys.exit()
        except ImportError:
            dbg('dbus not imported')
            pass

        MAKER = Factory()
        TERMINATOR.set_dbus_data(dbus_service)
        TERMINATOR.reconfigure()

        # Session restore / ownership (module A)
        sess = None
        restoring = False
        try:
            from terminatorlib.session import (SessionManager,
                                               SESSION_LAYOUT_NAME,
                                               is_explicit_launch)
            from terminatorlib.config import Config
            sess = SessionManager()
            got_lock = sess.acquire_lock()
            sess.set_owner_from_options(OPTIONS)
            sess.install_signal_handlers()
            if getattr(OPTIONS, 'clear_session', False):
                if got_lock:
                    sess.clear_session_files()
                else:
                    err('--clear-session ignored: another Terminator instance '
                        'owns the session')
            cfg = Config()
            want_restore = (
                (cfg['restore_last_session'] or getattr(OPTIONS, 'restore', False))
                and got_lock
                and getattr(OPTIONS, 'layout_from_default', False)
                and not OPTIONS.command and not OPTIONS.execute
                and not OPTIONS.working_directory and not OPTIONS.configjson
                and not getattr(OPTIONS, 'no_restore', False)
            )
            if want_restore:
                if sess.check_crash_marker():
                    sess._crash_skipped = True
                    # m31: fall back to .prev/.prev2, else the quarantined
                    # file in safe mode; a second crash goes empty.
                    data = sess.load_crash_fallback()
                    if not data:
                        dbg('session restore skipped: crash marker present')
                else:
                    data = sess.load()
                if data:
                    sess.begin_restore()
                    layout = sess.sanitize_layout(data['layout'])
                    cfg.base.layouts[SESSION_LAYOUT_NAME] = layout
                    sess._loaded_session_uuids = set()
                    for node in layout.values():
                        if isinstance(node, dict) and node.get('type') == 'Terminal':
                            uid = node.get('uuid')
                            if uid:
                                sess._loaded_session_uuids.add(str(uid))
                    OPTIONS.layout = SESSION_LAYOUT_NAME
                    sess.restored_this_run = True
                    restoring = True
                    dbg('restoring last session (%d terminals)' %
                        len(sess._loaded_session_uuids))
        except Exception as ex:
            err('session setup failed: %s' % ex)

        # B: start scrollback cache after lock/load, before create_layout.
        # Own try: a session setup failure must not disable the cache.
        try:
            from terminatorlib.scrollback import ScrollbackCache
            ScrollbackCache().start()
        except Exception as ex:
            err('ScrollbackCache.start: %s' % ex)

        windows_before = list(TERMINATOR.windows)
        try:
            dbg('Creating a terminal with layout: %s' % OPTIONS.layout)
            TERMINATOR.create_layout(OPTIONS.layout)
        except (KeyError,ValueError) as ex:
            err('layout creation failed, creating a window ("%s")' % ex)
            if restoring and sess is not None:
                sess.restore_failed(ex)
            TERMINATOR.new_window()
        except Exception as ex:
            # A malformed restored session must never stop startup
            err('layout creation crashed, creating a window ("%s")' % ex)
            if restoring and sess is not None:
                sess.restore_failed(ex)
            if not [w for w in TERMINATOR.windows if w not in windows_before]:
                TERMINATOR.new_window()
        try:
            if sess is not None and is_explicit_launch(OPTIONS):
                # -e/-x/-l NAME windows are not part of the session, but
                # the process still saves later plain windows (P1-5).
                sess.exclude_windows(
                    [w for w in TERMINATOR.windows if w not in windows_before])
        except Exception as ex:
            dbg('session exclude windows: %s' % ex)
        TERMINATOR.layout_done()

    if OPTIONS.debug and OPTIONS.debug >= 2:
        import terminatorlib.debugserver as debugserver
        # pylint: disable-msg=W0611
        import threading

        Gdk.threads_init()
        (DEBUGTHREAD, DEBUGSVR) = debugserver.spawn(locals())
        TERMINATOR.debug_address = DEBUGSVR.server_address

    try:
        Gtk.main()
    except KeyboardInterrupt:
        pass
    finally:
        # Exit paths that bypass the last-window/last-terminal hooks
        # (Ctrl+C, a stray main_quit) must still do the final save and the
        # synchronous scrollback flush.  finalize() is idempotent.
        # Not covered: losing the display connection makes GDK call C exit(),
        # which skips this block; only the debounced/periodic saves protect
        # that case.
        try:
            from terminatorlib.session import SessionManager
            SessionManager().finalize()
        except Exception as ex:
            err('session finalize at exit: %s' % ex)

